rules_version = '2';
// REHAB 氣瓶管制系統：匿名登入 + 隊碼。隊碼存在 teams/{t}/private/config，前端永遠讀不到；
// 只有輸入正確隊碼建立 joins/{uid} 的裝置才能讀寫該隊資料。
service cloud.firestore {
  match /databases/{database}/documents {
    function teamOk(t) { return t in ['taichung', 'selftest']; }
    function authed() { return request.auth != null; }
    function member(t) { return authed() && exists(/databases/$(database)/documents/teams/$(t)/joins/$(request.auth.uid)); }
    function smallDoc() { return request.resource.data.keys().size() <= 40; }

    match /teams/{t} {
      match /private/config {
        allow read: if false;
        allow create: if authed() && teamOk(t)
          && request.resource.data.keys().hasOnly(['code', 'createdBy', 'createdAt'])
          && request.resource.data.code is string
          && request.resource.data.code.size() >= 6 && request.resource.data.code.size() <= 64
          && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if false;
      }
      match /joins/{uid} {
        allow get: if authed() && request.auth.uid == uid;
        allow list: if false;
        allow create: if authed() && request.auth.uid == uid && teamOk(t)
          && request.resource.data.keys().hasOnly(['code', 'at', 'device'])
          && request.resource.data.code == get(/databases/$(database)/documents/teams/$(t)/private/config).data.code;
        allow update, delete: if false;
      }
      match /roster/{id} {
        allow read: if member(t);
        allow create, update: if member(t) && smallDoc()
          && request.resource.data.id is string && request.resource.data.id.size() <= 40;
        allow delete: if member(t);
      }
      match /records/{id} {
        allow read: if member(t);
        allow create, update: if member(t) && smallDoc() && request.resource.data.date is string;
        allow delete: if member(t);
      }
      match /vitals/{id} {
        allow read: if member(t);
        allow create, update: if member(t) && smallDoc() && request.resource.data.recId is string;
        allow delete: if member(t);
      }
    }
  }
}
