rules_version = '2';
// REHAB 氣瓶管制系統 v3
// 登入：輸入名冊內的「臂章號碼」或「義消證號」。名冊鍵以雜湊存在 rosterKeys（任何人不可讀），
// 以雜湊建立 members/{uid}（不設嘗試次數限制）。
// 系統開發者：密碼雜湊只存在本規則（不公開），設定只有開發者能改。
service cloud.firestore {
  match /databases/{database}/documents {
    function teamOk(t) { return t in ['taichung', 'selftest']; }
    function authed() { return request.auth != null; }
    function p(t, path) { return /databases/$(database)/documents/teams/$(t)/$(path); }
    function memberDoc(t) { return get(/databases/$(database)/documents/teams/$(t)/members/$(request.auth.uid)); }
    function isMember(t) { return authed() && exists(/databases/$(database)/documents/teams/$(t)/members/$(request.auth.uid))
      && exists(/databases/$(database)/documents/teams/$(t)/rosterKeys/$(memberDoc(t).data.key)); }
    function isDev(t) { return authed() && exists(/databases/$(database)/documents/teams/$(t)/devs/$(request.auth.uid)); }
    function canUse(t) { return isDev(t) || isMember(t); }
    function small() { return request.resource.data.keys().size() <= 40; }
    function byOk(t, by) { return isDev(t) || (by is map && by.key == memberDoc(t).data.key); }

    match /teams/{t} {
      // 舊版鎖定資料：已停用，只允許開發者清除
      match /guard/{uid} {
        allow get, delete: if authed() && request.auth.uid == uid;
        allow list, delete: if isDev(t);
      }
      match /rosterKeys/{h} {
        allow read: if false;
        allow create, update: if canUse(t) && request.resource.data.keys().hasOnly(['r', 'src'])
          && existsAfter(/databases/$(database)/documents/teams/$(t)/roster/$(request.resource.data.r));
        allow delete: if canUse(t);
      }
      match /members/{uid} {
        allow get: if authed() && request.auth.uid == uid;
        allow create, update: if authed() && request.auth.uid == uid && teamOk(t)
          && request.resource.data.keys().hasOnly(['key', 'at'])
          && request.resource.data.at == request.time
          && exists(/databases/$(database)/documents/teams/$(t)/rosterKeys/$(request.resource.data.key));
        allow delete: if authed() && request.auth.uid == uid;
      }
      match /devs/{uid} {
        allow get: if authed() && request.auth.uid == uid;
        allow create, update: if authed() && request.auth.uid == uid && teamOk(t)
          && request.resource.data.keys().hasOnly(['proof', 'at'])
          && request.resource.data.at == request.time
          && hashing.sha256(request.resource.data.proof).toHexString().lower() == '__DEV_H2__';
        allow delete: if authed() && request.auth.uid == uid;
      }
      match /config/{doc} {
        allow read: if canUse(t);
        allow write: if isDev(t);
      }
      match /roster/{id} {
        allow read: if canUse(t);
        allow create, update: if canUse(t) && small()
          && request.resource.data.id is string && request.resource.data.id.size() <= 40;
        allow delete: if canUse(t);
      }
      match /records/{id} {
        allow read: if canUse(t);
        allow create, update: if canUse(t) && small() && request.resource.data.date is string && byOk(t, request.resource.data.lastBy);
        allow delete: if isDev(t);
      }
      match /vitals/{id} {
        allow read: if canUse(t);
        allow create, update: if canUse(t) && small() && request.resource.data.recId is string && byOk(t, request.resource.data.by);
        allow delete: if canUse(t) && byOk(t, resource.data.by);
      }
    }
  }
}
